<!--
     AOSPA (beryl / Android 16) dependencies for the Motorola Moto G34/G45 5G
     (fogos, SM6375/holi).
-->
<manifest>
  <!-- Platform (holi is a 5.4 GKI platform, same family as lahaina) -->
  <include name="../platforms/holi.xml" />

  <!-- Device Dependencies -->
  <project path="device/motorola/fogos"
           name="nakchwalabhishek/android_device_motorola_fogos"
           remote="github" revision="aospa-calcite-fogos" />
  <project path="device/motorola/sm6375-common"
           name="nakchwalabhishek/android_device_motorola_sm6375-common"
           remote="github" revision="aospa-calcite-fogos" />

  <!-- Kernel (Lineage/AOSPA-compatible build integration; unchanged) -->
  <project path="kernel/motorola/sm6375"
           name="Motorola-SM6375-Devs/android_kernel_motorola_sm6375"
           remote="github" revision="sixteen" />

  <!-- Hardware (AOSPA's latest Motorola tree; provides MotoActions/MotoCommonOverlay/MotoNrEnabler) -->
  <project path="hardware/motorola"
           name="AOSPA/android_hardware_motorola"
           remote="aospa" revision="uvite" />

  <!-- Samsung SEC NFC HAL (used by the Moto/Samsung NFC firmware path) -->
  <project path="hardware/samsung_slsi/nfc"
           name="LineageOS/android_hardware_samsung_slsi_nfc"
           remote="github" revision="lineage-23.2" />

  <!-- Proprietary blobs -->
  <project path="vendor/motorola/fogos"
           name="TheMuppets/proprietary_vendor_motorola_fogos"
           remote="github" revision="lineage-23.2" clone-depth="1" />
  <project path="vendor/motorola/sm6375-common"
           name="TheMuppets/proprietary_vendor_motorola_sm6375-common"
           remote="github" revision="lineage-23.2" clone-depth="1" />
</manifest>
